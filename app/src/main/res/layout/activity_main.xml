<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1b1a18">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="BC-86AC Print Bridge"
            android:textColor="#f6f2e7"
            android:textSize="20sp"
            android:textStyle="bold"
            android:fontFamily="monospace" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="20dp"
            android:text="Keep this app open (or just installed and running in the background) and the printer connected. No Termux, no manual setup."
            android:textColor="#8a8073"
            android:textSize="12sp" />

        <!-- Update card -->
        <LinearLayout
            android:id="@+id/updateCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#242220"
            android:padding="16dp"
            android:layout_marginBottom="16dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="UPDATE"
                android:textColor="#8a8073"
                android:textSize="11sp"
                android:letterSpacing="0.08"
                android:fontFamily="monospace" />

            <TextView
                android:id="@+id/updateStatusText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="#d98b1f"
                android:textSize="13sp"
                android:fontFamily="monospace" />

            <Button
                android:id="@+id/installUpdateBtn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Download &amp; Install"
                android:textAllCaps="false"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Service status card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#242220"
            android:padding="16dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="BRIDGE SERVICE"
                android:textColor="#8a8073"
                android:textSize="11sp"
                android:letterSpacing="0.08"
                android:fontFamily="monospace" />

            <TextView
                android:id="@+id/serviceStatusText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Checking..."
                android:textColor="#f6f2e7"
                android:textSize="14sp"
                android:fontFamily="monospace" />

            <TextView
                android:id="@+id/lanAddressText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text=""
                android:textColor="#d98b1f"
                android:textSize="12sp"
                android:fontFamily="monospace" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="12dp">

                <Button
                    android:id="@+id/startServiceBtn"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:text="Start" />

                <Button
                    android:id="@+id/stopServiceBtn"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:text="Stop" />
            </LinearLayout>

            <Button
                android:id="@+id/batteryOptBtn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Disable battery optimization for this app" />
        </LinearLayout>

        <!-- USB card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#242220"
            android:padding="16dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="USB PRINTER"
                android:textColor="#8a8073"
                android:textSize="11sp"
                android:letterSpacing="0.08"
                android:fontFamily="monospace" />

            <TextView
                android:id="@+id/usbStatusText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="No USB printer paired"
                android:textColor="#f6f2e7"
                android:textSize="13sp"
                android:fontFamily="monospace" />

            <Button
                android:id="@+id/pairUsbBtn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Pair USB printer" />

            <Button
                android:id="@+id/testUsbBtn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Test print (USB)" />
        </LinearLayout>

        <!-- Network card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#242220"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="NETWORK PRINTER"
                android:textColor="#8a8073"
                android:textSize="11sp"
                android:letterSpacing="0.08"
                android:fontFamily="monospace" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Printer IP"
                android:textColor="#8a8073"
                android:textSize="10sp" />

            <EditText
                android:id="@+id/printerIpInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="text"
                android:textColor="#f6f2e7"
                android:fontFamily="monospace"
                android:hint="192.168.18.100" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Printer port"
                android:textColor="#8a8073"
                android:textSize="10sp" />

            <EditText
                android:id="@+id/printerPortInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number"
                android:textColor="#f6f2e7"
                android:fontFamily="monospace"
                android:hint="9100" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="10dp">

                <Button
                    android:id="@+id/saveNetworkBtn"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:text="Save" />

                <Button
                    android:id="@+id/testNetworkBtn"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:text="Test print (Network)" />
            </LinearLayout>
        </LinearLayout>

        <!-- Bridge Security card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#242220"
            android:padding="16dp"
            android:layout_marginTop="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="BRIDGE SECURITY"
                android:textColor="#8a8073"
                android:textSize="11sp"
                android:letterSpacing="0.08"
                android:fontFamily="monospace" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="HMAC secret for API authentication (32+ chars). Required for /print, /print-ticket, /status. Generate: openssl rand -hex 32"
                android:textColor="#8a8073"
                android:textSize="11sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Bridge Secret"
                android:textColor="#8a8073"
                android:textSize="10sp" />

            <EditText
                android:id="@+id/bridgeSecretInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textPassword"
                android:textColor="#f6f2e7"
                android:fontFamily="monospace"
                android:hint="Leave empty to disable auth (not recommended)" />

            <Button
                android:id="@+id/saveBridgeSecretBtn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Save Secret" />

        </LinearLayout>

        <!-- Cloud sync card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#242220"
            android:padding="16dp"
            android:layout_marginTop="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CLOUD SYNC (SUPABASE)"
                android:textColor="#8a8073"
                android:textSize="11sp"
                android:letterSpacing="0.08"
                android:fontFamily="monospace" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Lets your Vercel-hosted app queue print jobs that this tablet picks up automatically -- needed because Vercel can't reach this LAN directly."
                android:textColor="#8a8073"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/cloudSyncStatusText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Not configured"
                android:textColor="#f6f2e7"
                android:textSize="12sp"
                android:fontFamily="monospace" />

            <TextView
                android:id="@+id/cloudSyncDetailText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text=""
                android:textColor="#8a8073"
                android:textSize="10sp"
                android:fontFamily="monospace"
                android:visibility="gone" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Supabase project URL"
                android:textColor="#8a8073"
                android:textSize="10sp" />

            <EditText
                android:id="@+id/supabaseUrlInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textUri"
                android:textColor="#f6f2e7"
                android:fontFamily="monospace"
                android:hint="https://xxxx.supabase.co"
                android:focusable="false"
                android:focusableInTouchMode="false"
                android:alpha="0.7" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Supabase anon (public) key"
                android:textColor="#8a8073"
                android:textSize="10sp" />

            <EditText
                android:id="@+id/supabaseKeyInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textPassword"
                android:textColor="#f6f2e7"
                android:fontFamily="monospace"
                android:hint="eyJhbGciOi..."
                android:focusable="false"
                android:focusableInTouchMode="false"
                android:alpha="0.7" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="10dp">

                <Button
                    android:id="@+id/saveCloudBtn"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="4dp"
                    android:text="Save"
                    android:textAllCaps="false"
                    android:visibility="gone" />

                <Button
                    android:id="@+id/editCloudBtn"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="4dp"
                    android:text="Edit"
                    android:textAllCaps="false" />

                <Button
                    android:id="@+id/testCloudBtn"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    android:text="Test Sync"
                    android:textAllCaps="false" />
            </LinearLayout>

        </LinearLayout>

    </LinearLayout>
</ScrollView>
